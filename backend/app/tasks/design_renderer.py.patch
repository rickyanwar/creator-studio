 logger = logging.getLogger(__name__)
 
+import re
+
+def clean_title_for_render(title: str) -> str:
+    if not title:
+        return ""
+    title = re.sub(r'(\*\*|__)', '', title)
+    title = re.sub(r'`', '', title)
+    return title.strip()
+
+def clear_template_text_objects(template_json: dict):
+    if not template_json or "objects" not in template_json:
+        return
+    for obj in template_json.get("objects", []):
+        role = obj.get("placeholderRole")
+        if role in ("title", "subtitle", "caption", "label"):
+            if "text" in obj:
+                obj["text"] = ""
+
