# gemini-web-serve environment
# Copy to /etc/gemini-web-serve.env (chmod 600)

# Required: auth token (>= 24 chars). Generate with: openssl rand -hex 32
GWS_TOKEN=<generate with: openssl rand -hex 32>

# Bind address (default: docker bridge gateway)
GWS_BIND=172.17.0.1

# Listen port
GWS_PORT=8098

# Directory containing <name>.json account files
GWS_ACCOUNTS_DIR=/etc/gemini-web/accounts

# Persisted scheduler state
GWS_STATE_PATH=/var/lib/gemini-web-serve/state.json

# Default SOCKS proxy (phone via Tailscale)
GWS_DEFAULT_PROXY=socks5h://100.64.96.50:1080

# Gemini model
GWS_MODEL=gemini-argon

# Request timeout in seconds
GWS_REQUEST_TIMEOUT_S=600

# Stream watchdog timeout in seconds
GWS_WATCHDOG_TIMEOUT_S=300

# Scheduler overrides
GWS_SLEEP_MIN_H=3.5
GWS_SLEEP_MAX_H=4.5
GWS_GAP_MIN_M=4
GWS_GAP_MAX_M=9
GWS_CAP_MIN=30
GWS_CAP_MAX=40
GWS_BREAKS_MAX=2
# Argon thinking level: request (use the caller's flag), standard, or extended
GWS_THINKING=request

# Quota rest threshold (fraction 0.0-1.0). When the lowest-remaining quota bucket
# falls below this fraction, the account is rested until the bucket resets
# (+ a random 5-15 min jitter) without escalating the cooldown ladder.
GWS_QUOTA_REST_BELOW=0.2
