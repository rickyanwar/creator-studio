# Install: copy to /etc/systemd/system/gflow-worker.service, create the protected
# /etc/gflow-worker.env, then run systemctl daemon-reload and enable --now.
# Concurrency: GFLOW_MAX_CONCURRENT defaults to 1. Set to 2 only when RAM allows (recommended after VPS RAM upgrade).
# Locking: worker takes shared flock on GFLOW_LOCK_FILE and exclusive flock per profile (gflow-flow.<profile>.lock).
# Hermes flow.sh takes exclusive flock on GFLOW_LOCK_FILE, excluding worker jobs while allowing 2 worker jobs concurrently.
# Proxy: GFLOW_PROXY (e.g. socks5://100.64.96.50:1080) can be configured in /etc/gflow-worker.env to route via residential mobile proxy.
[Unit]
Description=Studio Google Flow video worker
After=network-online.target
Wants=network-online.target

[Service]
User=gflow
Group=gflow
WorkingDirectory=/opt/studio
EnvironmentFile=/etc/gflow-worker.env
ExecStart=/home/gflow/.local/bin/uv run --project /home/gflow/gflow-cli-083 python -m gflow_worker
SuccessExitStatus=143
Restart=on-failure
RestartSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
